# OpenClaw Hugging Face Space 环境变量示例文件。
# 将你需要的变量复制到 HF Space 的 Settings -> Variables / Secrets 中。

# -----------------------------------------------------------------------------
# 必填 / 强烈建议配置
# -----------------------------------------------------------------------------

# HF 挂载桶中的持久化根目录。
# 需要与 HF 挂载到容器内的 /data 路径保持一致。
OPENCLAW_HF_DATA_ROOT=/data/openclaw

# Gateway 在容器内监听的端口。
OPENCLAW_HF_GATEWAY_PORT=18789

# Gateway 的绑定模式。
# 在 HF 容器部署场景下使用 lan，便于平台路由访问 HTTP 服务。
OPENCLAW_HF_GATEWAY_BIND=lan

# Gateway 鉴权令牌。
# 强烈建议配置，并且应当在 HF 中作为 Secret 保存。
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token


# -----------------------------------------------------------------------------
# HF 包装层运行行为
# -----------------------------------------------------------------------------

# 是否启用后台同步守护进程。
# 除非你在排查问题，否则建议保持为 1。
OPENCLAW_HF_SYNC_ENABLED=1

# 追加到 gateway run 命令后的额外参数。
# 实际启动命令基础形态为：
# openclaw gateway run --bind "$OPENCLAW_HF_GATEWAY_BIND" --port "$OPENCLAW_HF_GATEWAY_PORT" --allow-unconfigured
# 示例：
# OPENCLAW_HF_GATEWAY_EXTRA_ARGS=--verbose
OPENCLAW_HF_GATEWAY_EXTRA_ARGS=

# 以下为高级调试 / 自定义目录覆盖项。
# 正常 HF Space 部署通常不需要设置，保持注释状态即可。

# 持久化主状态目录在桶中的完整路径。
# OPENCLAW_HF_LIVE_ROOT=/data/openclaw/live/.openclaw

# 同步元数据、锁、清单、队列所在目录。
# OPENCLAW_HF_SYNC_ROOT=/data/openclaw/sync

# 同步日志与归档日志所在目录。
# OPENCLAW_HF_LOG_ROOT=/data/openclaw/logs

# 安装资产、插件、skills 持久化目录。
# OPENCLAW_HF_INSTALL_ROOT=/data/openclaw/install

# 运行时 HOME 目录。
# OPENCLAW_HF_RUNTIME_HOME=/root

# OpenClaw 运行时状态根目录。
# OPENCLAW_HF_RUNTIME_ROOT=/root/.openclaw

# HF 包装脚本在容器内的安装目录。
# OPENCLAW_HF_APP_DIR=/opt/openclaw-hf

# 强持久化状态处理模式。
# mixed = 强状态优先用链接/混合模式；copy = 用复制模式。
# OPENCLAW_HF_STATE_LINK_MODE=mixed

# 每类冲突快照目录最多保留多少份历史快照。
# OPENCLAW_HF_SNAPSHOT_LIMIT=20

# manifest 中对文件计算 sha256 的大小阈值（字节）。
# 超过这个大小的文件只记录元数据，不计算哈希。
# OPENCLAW_HF_MANIFEST_HASH_LIMIT_BYTES=10485760

# 配置文件冲突策略。
# data_wins = 以 /data 为准；runtime_wins = 以运行目录为准；newer_wins = 以较新文件为准。
# OPENCLAW_HF_CONFIG_CONFLICT_POLICY=data_wins

# 强持久化目录恢复冲突策略。
# data_wins = 以 /data 为准；runtime_wins = 以运行目录为准；newer_wins = 以较新文件为准。
# OPENCLAW_HF_STRONG_DIR_RESTORE_POLICY=data_wins

# 本地后同步目录恢复冲突策略。
# newer_wins = 以较新文件为准；data_wins = 以 /data 为准；runtime_wins = 以运行目录为准。
# OPENCLAW_HF_LOCAL_SYNC_RESTORE_POLICY=newer_wins


# -----------------------------------------------------------------------------
# HF 自定义模型切换变量（统一使用 OpenAI 兼容接口）
# -----------------------------------------------------------------------------

# 主模型当前启用哪一套。
# 支持 FIRST / SECOND / THIRD / FOURTH / FIFTH，也兼容 1 / 2 / 3 / 4 / 5。
OPENCLAW_PRIMARY_MODEL_SET=FIRST

# 第一套主模型：URL / KEY / MODEL。
OPENCLAW_FIRST_URL=replace-with-first-url
OPENCLAW_FIRST_KEY=replace-with-first-key
OPENCLAW_FIRST_MODEL=replace-with-first-model

# 第二套主模型：URL / KEY / MODEL。
OPENCLAW_SECOND_URL=replace-with-second-url
OPENCLAW_SECOND_KEY=replace-with-second-key
OPENCLAW_SECOND_MODEL=replace-with-second-model

# 第三套主模型：URL / KEY / MODEL。
OPENCLAW_THIRD_URL=replace-with-third-url
OPENCLAW_THIRD_KEY=replace-with-third-key
OPENCLAW_THIRD_MODEL=replace-with-third-model

# 第四套主模型：URL / KEY / MODEL。
OPENCLAW_FOURTH_URL=replace-with-fourth-url
OPENCLAW_FOURTH_KEY=replace-with-fourth-key
OPENCLAW_FOURTH_MODEL=replace-with-fourth-model

# 第五套主模型：URL / KEY / MODEL。
OPENCLAW_FIFTH_URL=replace-with-fifth-url
OPENCLAW_FIFTH_KEY=replace-with-fifth-key
OPENCLAW_FIFTH_MODEL=replace-with-fifth-model

# 文生图专用模型：URL / KEY / MODEL。
# 会写入 canonical provider：openai
OPENCLAW_TEXT_TO_IMAGE_URL=replace-with-text-to-image-url
OPENCLAW_TEXT_TO_IMAGE_KEY=replace-with-text-to-image-key
OPENCLAW_TEXT_TO_IMAGE_MODEL=replace-with-text-to-image-model

# 图生图专用模型：URL / KEY / MODEL。
# 会与文生图一起落到 canonical provider：openai
OPENCLAW_IMAGE_TO_IMAGE_URL=replace-with-image-to-image-url
OPENCLAW_IMAGE_TO_IMAGE_KEY=replace-with-image-to-image-key
OPENCLAW_IMAGE_TO_IMAGE_MODEL=replace-with-image-to-image-model

# 图生视频专用模型：URL / KEY / MODEL。
# 当前也会走 canonical provider：openai。
# 如果你给图生视频配置了与文生图不同的 URL/KEY，启动日志会发出告警；当前实现无法同时给 openai 生图和 openai 视频使用两套不同 endpoint。
OPENCLAW_IMAGE_TO_VIDEO_URL=replace-with-image-to-video-url
OPENCLAW_IMAGE_TO_VIDEO_KEY=replace-with-image-to-video-key
OPENCLAW_IMAGE_TO_VIDEO_MODEL=replace-with-image-to-video-model

# 允许 OpenClaw 图片生成 provider 访问容器内本地 bridge（如 127.0.0.1:18891）。
OPENCLAW_QA_ALLOW_LOCAL_IMAGE_PROVIDER=1


# -----------------------------------------------------------------------------
# HF 中常见的 OpenClaw 运行时变量
# -----------------------------------------------------------------------------

# 时区设置。
# 如果你的 provider、日志或定时任务依赖固定时区，可以在这里配置。
TZ=Asia/Shanghai

# 是否允许私有网络中的 ws:// 明文连接。
# 仅在你明确知道自己需要时再开启。
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1


# -----------------------------------------------------------------------------
# OpenClaw China 渠道变量
# -----------------------------------------------------------------------------

# 企业微信智能机器人（wecom）长连接模式。
# 当前 HF 镜像会预置 wecom / wecom-app / openclaw-weixin 三个插件。
WECOM_WS_BOT_ID=replace-with-wecom-ws-bot-id
WECOM_WS_SECRET=replace-with-wecom-ws-secret
WECOM_CORP_ID=replace-with-wecom-corp-id

# 你的 HF Space 外网基础地址。
# 主要用于需要公网回调或白名单提示的渠道。
PUBLIC_BASE_URL=https://your-space-name.hf.space

# 企业微信自建应用（wecom-app）。
WECOM_APP_TOKEN=replace-with-wecom-app-token
WECOM_APP_AES_KEY=replace-with-wecom-app-aes-key
WECOM_APP_SECRET=replace-with-wecom-app-secret
WECOM_APP_AGENTID=1000008

# 企业微信群机器人 Webhook Key（可选，用于后续 IP 变更通知）。
WECOM_WEBHOOK_KEY=replace-with-wecom-webhook-key

# 企业微信自建应用语音识别（腾讯云 ASR）。
WECOM_APP_ASR_APP_ID=replace-with-wecom-app-asr-app-id
WECOM_APP_ASR_SECRET_ID=replace-with-wecom-app-asr-secret-id
WECOM_APP_ASR_SECRET_KEY=replace-with-wecom-app-asr-secret-key

# QQ 机器人。
QQBOT_APP_ID=replace-with-qqbot-app-id
QQBOT_CLIENT_SECRET=replace-with-qqbot-client-secret

# QQ 机器人语音识别（腾讯云 ASR）。
QQBOT_ASR_APP_ID=replace-with-qqbot-asr-app-id
QQBOT_ASR_SECRET_ID=replace-with-qqbot-asr-secret-id
QQBOT_ASR_SECRET_KEY=replace-with-qqbot-asr-secret-key

# 飞书机器人。
# 当前 HF 部署使用 OpenClaw 内置 `feishu` 渠道，不再写入旧的 `feishu-china`。
FEISHU_APP_ID=replace-with-feishu-app-id
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_VERIFICATION_TOKEN=replace-with-feishu-verification-token
FEISHU_ENCRYPT_KEY=replace-with-feishu-encrypt-key

# 微信公众号变量本轮暂不启用，先保留给后续扩展。
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_AUTO_MODE=false

# 微信个人号插件启动时是否进入扫码登录流程。
# OPEN = 启动时自动执行 openclaw channels login --channel openclaw-weixin
# CLOLD = 不自动触发扫码登录
OPENCLAW_WEIXIN_LOGIN_ON_START=CLOLD

# 微信个人号插件运行配置。
# 这些变量用于在重启后继续生成 channels.openclaw-weixin 配置，不依赖再次扫码。
WEIXIN_ACCOUNT_ID=replace-with-weixin-account-id
WEIXIN_TOKEN=replace-with-weixin-token
WEIXIN_BASE_URL=https://replace-with-weixin-base-url.example
WEIXIN_CDN_BASE_URL=https://replace-with-weixin-cdn-base-url.example

# 梧州天气 cron 主动发送的微信目标 ID。
WEIXIN_TO=replace-with-weather-weixin-target-id

# Tavily 搜索 API Key。
# 该变量供 Tavily Python SDK 和后续 Tavily 搜索能力使用。
TAVILY_API_KEY=replace-with-tavily-api-key

# 当前启用的 Web Search Provider。
# 支持 tavily 或 searxng。
OPENCLAW_WEB_SEARCH_PROVIDER=tavily

# SearXNG 主搜索实例。
# n2-free-search 可优先使用这个实例。
SEARXNG_URL=https://replace-with-primary-searxng.example

# SearXNG 与 OpenClaw provider 配置直接对接时使用的主地址。
# 建议与 SEARXNG_URL 保持一致。
SEARXNG_BASE_URL=https://replace-with-primary-searxng.example

# SearXNG 备用实例 1。
SEARXNG_URL_BACKUP_1=https://replace-with-backup-searxng-1.example

# SearXNG 备用实例 2。
SEARXNG_URL_BACKUP_2=https://replace-with-backup-searxng-2.example

# SearXNG 备用实例 3。
SEARXNG_URL_BACKUP_3=https://replace-with-backup-searxng-3.example

# SearXNG 备用实例 4。
SEARXNG_URL_BACKUP_4=https://replace-with-backup-searxng-4.example


# -----------------------------------------------------------------------------
# 说明
# -----------------------------------------------------------------------------

# 1. HF 包装层会在启动时把持久化状态从：
#    /data/openclaw/live/.openclaw
#    恢复到运行目录：
#    /root/.openclaw
#
# 2. 启动脚本会根据 OPENCLAW_PRIMARY_MODEL_SET 选择当前聊天主模型，写入 provider hf-openai-chat。
#    文生图/图生图/图生视频当前都写入 provider openai。
# 3. 如果文生图通过 HF 容器内本地 bridge 转换 URL -> b64_json，需要开启 OPENCLAW_QA_ALLOW_LOCAL_IMAGE_PROVIDER=1。
#
# 4. HF 当前使用内置 QQ / 飞书渠道，以及预置 wecom / wecom-app / openclaw-weixin 插件。
#
# 5. ddg-web-search 与 n2-free-search 会在镜像构建阶段预置到 /opt/openclaw-hf/prebuilt/skills，启动时复制到运行目录。
#
# 6. 启动脚本会根据 OPENCLAW_WEB_SEARCH_PROVIDER 选择 Tavily 或 SearXNG 作为当前主搜索 provider。
#
# 7. 如果你要加入自定义插件 / skill 安装逻辑，可以把一个可执行脚本放到：
#    /data/openclaw/install/bootstrap/install-extra.local.sh
