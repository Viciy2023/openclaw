# Hugging Face Space environment example for the OpenClaw HF wrapper.
# Copy the values you need into your HF Space Settings -> Variables / Secrets.

# -----------------------------------------------------------------------------
# Required / strongly recommended
# -----------------------------------------------------------------------------

# Persisted root inside the mounted HF bucket.
# Keep this aligned with the mounted /data volume.
OPENCLAW_HF_DATA_ROOT=/data/openclaw

# Gateway port exposed inside the container.
OPENCLAW_HF_GATEWAY_PORT=18789

# Use lan inside containerized deployments so HF can reach the HTTP server.
OPENCLAW_HF_GATEWAY_BIND=lan

# Strongly recommended when binding beyond loopback.
# Set this as an HF Secret.
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token


# -----------------------------------------------------------------------------
# HF wrapper behavior
# -----------------------------------------------------------------------------

# Keep the background sync daemon enabled unless you are debugging.
OPENCLAW_HF_SYNC_ENABLED=1

# Optional extra args appended to:
# openclaw gateway run --bind "$OPENCLAW_HF_GATEWAY_BIND" --port "$OPENCLAW_HF_GATEWAY_PORT" --allow-unconfigured
# Example:
# OPENCLAW_HF_GATEWAY_EXTRA_ARGS=--verbose
OPENCLAW_HF_GATEWAY_EXTRA_ARGS=

# Optional overrides for advanced debugging / custom layouts.
# In normal HF Space usage, leave these unset.
# OPENCLAW_HF_LIVE_ROOT=/data/openclaw/live/.openclaw
# OPENCLAW_HF_SYNC_ROOT=/data/openclaw/sync
# OPENCLAW_HF_LOG_ROOT=/data/openclaw/logs
# OPENCLAW_HF_INSTALL_ROOT=/data/openclaw/install
# OPENCLAW_HF_RUNTIME_HOME=/root
# OPENCLAW_HF_RUNTIME_ROOT=/root/.openclaw
# OPENCLAW_HF_APP_DIR=/opt/openclaw-hf
# OPENCLAW_HF_STATE_LINK_MODE=mixed
# OPENCLAW_HF_SNAPSHOT_LIMIT=20
# OPENCLAW_HF_MANIFEST_HASH_LIMIT_BYTES=10485760
# OPENCLAW_HF_CONFIG_CONFLICT_POLICY=data_wins
# OPENCLAW_HF_STRONG_DIR_RESTORE_POLICY=data_wins
# OPENCLAW_HF_LOCAL_SYNC_RESTORE_POLICY=newer_wins


# -----------------------------------------------------------------------------
# Optional OpenClaw runtime variables commonly needed in HF
# -----------------------------------------------------------------------------

# Helpful if your provider or logging depends on a fixed timezone.
TZ=UTC

# Allow ws:// private-network clients when your deployment pattern requires it.
# Leave unset unless you know you need it.
# OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1


# -----------------------------------------------------------------------------
# Model / provider credentials
# -----------------------------------------------------------------------------

# Set only the providers you actually use.
# Prefer HF Secrets for all credentials.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=


# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------

# 1. The HF wrapper restores persisted OpenClaw state from:
#    /data/openclaw/live/.openclaw
#    into:
#    /root/.openclaw
#
# 2. During runtime, the sync daemon pushes state back into /data/openclaw using
#    tiered sync intervals for config, agents, workspace, cron, media, and logs.
#
# 3. If you want custom plugin / skill bootstrap logic, place an executable script
#    at:
#    /data/openclaw/install/bootstrap/install-extra.local.sh
